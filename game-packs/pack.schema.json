{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parlor.local/schemas/game-pack.json",
  "title": "Parlor JSON Game Pack",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\\\:?#]).+\\.(?:[Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg]|[Ww][Ee][Bb][Pp]|[Aa][Vv][Ii][Ff])$"
    }
  },
  "required": ["id", "name", "version", "cardBack", "die", "cards"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "tableTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cardBack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 20 },
        "theme": { "type": "string", "maxLength": 40 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "image": { "$ref": "#/$defs/assetPath" }
      }
    },
    "die": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "sides"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 20 },
        "sides": { "type": "integer", "minimum": 2, "maximum": 20 }
      }
    },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "initial", "min", "max"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 20 },
        "initial": { "type": "integer", "minimum": -9999, "maximum": 9999 },
        "min": { "type": "integer", "minimum": -9999, "maximum": 9999 },
        "max": { "type": "integer", "minimum": -9999, "maximum": 9999 }
      }
    },
    "tokens": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "symbol", "color", "x", "y"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 40 },
          "label": { "type": "string", "minLength": 1, "maxLength": 20 },
          "symbol": { "type": "string", "minLength": 1, "maxLength": 2 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "image": { "$ref": "#/$defs/assetPath" }
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "rank", "suit", "symbol"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 60 },
          "label": { "type": "string", "minLength": 1, "maxLength": 20 },
          "rank": { "type": "string", "maxLength": 8 },
          "suit": { "type": "string", "maxLength": 30 },
          "symbol": { "type": "string", "minLength": 1, "maxLength": 4 },
          "tone": { "type": "string", "enum": ["red", "black"] },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "textColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "image": { "$ref": "#/$defs/assetPath" }
        }
      }
    }
  }
}
